# UrbanTwin Predictive Urban Digital Twin - Sample 3D Architectural Model
# Format: Wavefront OBJ File (.obj)
# Structure: 12-Story Commercial High-Rise with Podium Base & Helipad
# Target: SIH 2026 Pre-Implementation CAD Simulation Test

g Building_Podium_Base
# Vertices for Ground Podium (40m x 40m x 8m)
v -20.0 0.0 -20.0
v  20.0 0.0 -20.0
v  20.0 8.0 -20.0
v -20.0 8.0 -20.0
v -20.0 0.0  20.0
v  20.0 0.0  20.0
v  20.0 8.0  20.0
v -20.0 8.0  20.0

# Podium Faces
f 1 2 3 4
f 5 8 7 6
f 1 5 6 2
f 2 6 7 3
f 3 7 8 4
f 5 1 4 8

g Building_Tower_Main
# Vertices for Main Tower (28m x 28m x 40m Height: Y=8m to Y=48m)
v -14.0  8.0 -14.0
v  14.0  8.0 -14.0
v  14.0 48.0 -14.0
v -14.0 48.0 -14.0
v -14.0  8.0  14.0
v  14.0  8.0  14.0
v  14.0 48.0  14.0
v -14.0 48.0  14.0

# Tower Main Faces
f 9 10 11 12
f 13 16 15 14
f 9 13 14 10
f 10 14 15 11
f 11 15 16 12
f 13 9 12 16

g Building_Roof_Helipad
# Vertices for Roof Parapet & Helipad Deck (Y=48m to Y=50m)
v -10.0 48.0 -10.0
v  10.0 48.0 -10.0
v  10.0 50.0 -10.0
v -10.0 50.0 -10.0
v -10.0 48.0  10.0
v  10.0 48.0  10.0
v  10.0 50.0  10.0
v -10.0 50.0  10.0

# Helipad Faces
f 17 18 19 20
f 21 24 23 22
f 17 21 22 18
f 18 22 23 19
f 19 23 24 20
f 21 17 20 24

# Structural Support Columns (Ground Level Flood Clearance)
g Pillar_Column_NW
v -19.0 0.0 -19.0
v -17.0 0.0 -19.0
v -17.0 8.0 -19.0
v -19.0 8.0 -19.0
v -19.0 0.0 -17.0
v -17.0 0.0 -17.0
v -17.0 8.0 -17.0
v -19.0 8.0 -17.0
f 25 26 27 28
f 29 32 31 30
f 25 29 30 26
f 26 30 31 27
f 27 31 32 28
f 29 25 28 32
